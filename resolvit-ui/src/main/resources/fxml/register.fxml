<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  ResolvIt - Register Screen
  Student registration form with password strength meter
  @author ResolvIt Team
  @version 1.0.0
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.resolvit.ui.controllers.RegisterController"
            styleClass="root"
            prefWidth="1024" prefHeight="768">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox alignment="CENTER" spacing="0">
                <padding>
                    <Insets top="40" bottom="40"/>
                </padding>

                <!-- Register Card -->
                <VBox styleClass="card" maxWidth="500" spacing="24"
                      fx:id="registerCard">
                    <padding>
                        <Insets top="32" right="40" bottom="32" left="40"/>
                    </padding>

                    <!-- Header -->
                    <VBox alignment="CENTER" spacing="8">
                        <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                            <image>
                                <Image url="@../assets/logo.png"/>
                            </image>
                        </ImageView>
                        <Label text="Create Account" styleClass="label-title"/>
                        <Label text="Join ResolvIt to submit and track complaints"
                               styleClass="label-secondary"/>
                    </VBox>

                    <!-- Registration Form -->
                    <VBox spacing="16">
                        <!-- Full Name -->
                        <VBox styleClass="form-group">
                            <Label text="Full Name *" styleClass="form-label"/>
                            <TextField fx:id="nameField"
                                       promptText="Enter your full name"
                                       styleClass="text-field"/>
                            <Label fx:id="nameError" styleClass="form-error"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Email -->
                        <VBox styleClass="form-group">
                            <Label text="Email *" styleClass="form-label"/>
                            <TextField fx:id="emailField"
                                       promptText="Enter your college email"
                                       styleClass="text-field"/>
                            <Label fx:id="emailError" styleClass="form-error"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Roll Number and Class (side by side) -->
                        <HBox spacing="16">
                            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                                <Label text="Roll Number" styleClass="form-label"/>
                                <TextField fx:id="rollNumberField"
                                           promptText="e.g., 21CS001"
                                           styleClass="text-field"/>
                            </VBox>
                            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                                <Label text="Class" styleClass="form-label"/>
                                <TextField fx:id="classNameField"
                                           promptText="e.g., CSE-A"
                                           styleClass="text-field"/>
                            </VBox>
                        </HBox>

                        <!-- Phone -->
                        <VBox styleClass="form-group">
                            <Label text="Phone Number" styleClass="form-label"/>
                            <TextField fx:id="phoneField"
                                       promptText="Enter your phone number"
                                       styleClass="text-field"/>
                        </VBox>

                        <!-- Department -->
                        <VBox styleClass="form-group">
                            <Label text="Department" styleClass="form-label"/>
                            <ComboBox fx:id="departmentComboBox"
                                      promptText="Select your department"
                                      styleClass="combo-box"
                                      prefWidth="Infinity"/>
                        </VBox>

                        <!-- Password -->
                        <VBox styleClass="form-group" spacing="8">
                            <Label text="Password *" styleClass="form-label"/>
                            <PasswordField fx:id="passwordField"
                                           promptText="Create a strong password"
                                           styleClass="text-field"/>
                            
                            <!-- Password Strength Meter -->
                            <VBox fx:id="strengthMeterContainer" spacing="6">
                                <HBox spacing="4" styleClass="password-strength">
                                    <Region fx:id="strengthBar1" prefWidth="80" prefHeight="4"
                                            styleClass="password-strength-bar password-strength-bar-empty"/>
                                    <Region fx:id="strengthBar2" prefWidth="80" prefHeight="4"
                                            styleClass="password-strength-bar password-strength-bar-empty"/>
                                    <Region fx:id="strengthBar3" prefWidth="80" prefHeight="4"
                                            styleClass="password-strength-bar password-strength-bar-empty"/>
                                    <Region fx:id="strengthBar4" prefWidth="80" prefHeight="4"
                                            styleClass="password-strength-bar password-strength-bar-empty"/>
                                </HBox>
                                <Label fx:id="strengthLabel" text="" styleClass="password-strength-label form-hint"/>
                            </VBox>
                            
                            <Label fx:id="passwordError" styleClass="form-error"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox styleClass="form-group">
                            <Label text="Confirm Password *" styleClass="form-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Re-enter your password"
                                           styleClass="text-field"/>
                            <Label fx:id="confirmPasswordError" styleClass="form-error"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- General Error Message -->
                        <HBox fx:id="errorContainer" visible="false" managed="false"
                              alignment="CENTER" styleClass="form-error">
                            <padding>
                                <Insets top="8" bottom="8"/>
                            </padding>
                            <Label fx:id="errorLabel" styleClass="text-danger"/>
                        </HBox>

                        <!-- Register Button -->
                        <Button fx:id="registerButton"
                                text="CREATE ACCOUNT"
                                onAction="#onRegisterClick"
                                styleClass="btn-primary"
                                prefWidth="Infinity"
                                prefHeight="44"/>

                        <!-- Loading Indicator -->
                        <HBox fx:id="loadingContainer" visible="false" managed="false"
                              alignment="CENTER" spacing="8">
                            <ProgressIndicator prefWidth="24" prefHeight="24"
                                               styleClass="loading-spinner"/>
                            <Label text="Creating account..." styleClass="loading-text"/>
                        </HBox>
                    </VBox>

                    <!-- Login Link -->
                    <HBox alignment="CENTER" spacing="4">
                        <Label text="Already have an account?" styleClass="label-secondary"/>
                        <Hyperlink text="Sign in" onAction="#onBackToLogin"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
