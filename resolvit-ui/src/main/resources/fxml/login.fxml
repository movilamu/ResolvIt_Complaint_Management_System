<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<!--
  ResolvIt - Login Screen
  Primary authentication screen for all users
  @author ResolvIt Team
  @version 1.0.0
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.resolvit.ui.controllers.LoginController"
            styleClass="root"
            prefWidth="1024" prefHeight="768">

    <center>
        <VBox alignment="CENTER" spacing="0">
            <!-- Login Card -->
            <VBox styleClass="card" maxWidth="420" spacing="24"
                  fx:id="loginCard">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Logo and Title -->
                <VBox alignment="CENTER" spacing="8">
                    <ImageView fx:id="logoImage" fitWidth="80" fitHeight="80"
                               preserveRatio="true">
                        <image>
                            <Image url="@../assets/logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="ResolvIt" styleClass="logo-text"/>
                    <Label text="Every complaint heard. Every issue resolved."
                           styleClass="label-tagline"/>
                </VBox>

                <!-- Spacer -->
                <Region prefHeight="16"/>

                <!-- Login Form -->
                <VBox spacing="16">
                    <!-- Email Field -->
                    <VBox styleClass="form-group">
                        <Label text="Email" styleClass="form-label"/>
                        <TextField fx:id="emailField"
                                   promptText="Enter your email (e.g., student@college.edu)"
                                   styleClass="text-field"/>
                    </VBox>

                    <!-- Password Field -->
                    <VBox styleClass="form-group">
                        <Label text="Password" styleClass="form-label"/>
                        <HBox spacing="8">
                            <PasswordField fx:id="passwordField"
                                           promptText="Enter your password"
                                           styleClass="text-field"
                                           HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="passwordTextField"
                                       promptText="Enter your password"
                                       styleClass="text-field"
                                       visible="false" managed="false"
                                       HBox.hgrow="ALWAYS"/>
                            <Button fx:id="togglePasswordBtn"
                                    text="Show"
                                    onAction="#togglePasswordVisibility"
                                    styleClass="button"
                                    minWidth="60"/>
                        </HBox>
                    </VBox>

                    <!-- Remember Me and Forgot Password -->
                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="rememberMeCheckbox" text="Remember me"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="forgotPasswordLink"
                                   text="Forgot Password?"
                                   onAction="#onForgotPassword"/>
                    </HBox>

                    <!-- Error Message -->
                    <HBox fx:id="errorContainer" visible="false" managed="false"
                          alignment="CENTER" styleClass="form-error">
                        <padding>
                            <Insets top="8" bottom="8"/>
                        </padding>
                        <Label fx:id="errorLabel" styleClass="text-danger"/>
                    </HBox>

                    <!-- Login Button -->
                    <Button fx:id="loginButton"
                            text="LOGIN"
                            onAction="#onLoginClick"
                            styleClass="btn-primary"
                            prefWidth="Infinity"
                            prefHeight="44"/>

                    <!-- Loading Indicator (hidden by default) -->
                    <HBox fx:id="loadingContainer" visible="false" managed="false"
                          alignment="CENTER" spacing="8">
                        <ProgressIndicator fx:id="loadingIndicator"
                                           prefWidth="24" prefHeight="24"
                                           styleClass="loading-spinner"/>
                        <Label text="Signing in..." styleClass="loading-text"/>
                    </HBox>
                </VBox>

                <!-- Spacer -->
                <Region prefHeight="8"/>

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="New student?" styleClass="label-secondary"/>
                    <Hyperlink fx:id="registerLink"
                               text="Register here"
                               onAction="#onRegisterClick"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="8">
            <padding>
                <Insets top="16" bottom="24"/>
            </padding>
            <Label text="© 2024 ResolvIt. All rights reserved."
                   styleClass="text-muted"/>
        </HBox>
    </bottom>
</BorderPane>
