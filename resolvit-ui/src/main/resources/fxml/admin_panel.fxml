<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ResolvIt - Admin Panel
  Main dashboard for admins to manage complaints
  @author ResolvIt Team
  @version 1.0.0
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.resolvit.ui.controllers.AdminPanelController"
            styleClass="root">

    <!-- Top Bar -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="ResolvIt Admin" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox alignment="CENTER_RIGHT" spacing="16">
                <Button fx:id="themeToggleBtn" text="Theme"
                        onAction="#onToggleTheme" styleClass="btn-icon"/>
                <StackPane>
                    <Button fx:id="notificationsBtn" text="Notifications"
                            onAction="#onNotificationsClick" styleClass="btn-icon"/>
                    <Label fx:id="notificationBadge" text="0"
                           styleClass="notification-badge"
                           visible="false" managed="false"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>
                <MenuButton fx:id="userMenuBtn" styleClass="button">
                    <items>
                        <MenuItem text="Profile" onAction="#onProfileClick"/>
                        <MenuItem text="Analytics" onAction="#onAnalyticsClick"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Logout" onAction="#onLogout"/>
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox>
            <!-- Sidebar -->
            <VBox fx:id="sidebar" styleClass="sidebar">
                <VBox styleClass="sidebar-header">
                    <Label fx:id="welcomeLabel" text="Admin Panel"
                           styleClass="label-subtitle"/>
                    <Label fx:id="userInfoLabel" styleClass="label-secondary"/>
                </VBox>

                <VBox fx:id="navContainer" spacing="4">
                    <padding>
                        <Insets top="16"/>
                    </padding>
                    
                    <HBox fx:id="navDashboard" styleClass="sidebar-item sidebar-item-active"
                          onMouseClicked="#onNavDashboard">
                        <Label text="Dashboard" styleClass="sidebar-item-text"/>
                    </HBox>
                    
                    <HBox fx:id="navComplaints" styleClass="sidebar-item"
                          onMouseClicked="#onNavComplaints">
                        <Label text="All Complaints" styleClass="sidebar-item-text"/>
                    </HBox>
                    
                    <HBox fx:id="navAnalytics" styleClass="sidebar-item"
                          onMouseClicked="#onNavAnalytics">
                        <Label text="Analytics" styleClass="sidebar-item-text"/>
                    </HBox>
                    
                    <HBox fx:id="navReports" styleClass="sidebar-item"
                          onMouseClicked="#onNavReports">
                        <Label text="Reports" styleClass="sidebar-item-text"/>
                    </HBox>
                    
                    <HBox fx:id="navNotifications" styleClass="sidebar-item"
                          onMouseClicked="#onNavNotifications">
                        <Label text="Notifications" styleClass="sidebar-item-text"/>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox>
                    <padding>
                        <Insets bottom="16"/>
                    </padding>
                    <HBox styleClass="sidebar-item" onMouseClicked="#onLogout">
                        <Label text="Logout" styleClass="sidebar-item-text"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Main Content -->
            <VBox fx:id="mainContent" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="24" right="32" bottom="24" left="32"/>
                </padding>

                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS">
                    <VBox spacing="24">
                        <Label fx:id="dashboardTitle" text="Complaints Management"
                               styleClass="label-title"/>

                        <!-- Filter Bar -->
                        <VBox styleClass="card filter-bar">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <TextField fx:id="searchField"
                                           promptText="Search by title or ID..."
                                           styleClass="text-field" prefWidth="250"/>
                                
                                <ComboBox fx:id="statusFilter"
                                          promptText="Status" styleClass="combo-box"/>
                                
                                <ComboBox fx:id="categoryFilter"
                                          promptText="Category" styleClass="combo-box"/>
                                
                                <ComboBox fx:id="priorityFilter"
                                          promptText="Priority" styleClass="combo-box"/>
                                
                                <DatePicker fx:id="fromDatePicker"
                                            promptText="From Date"/>
                                
                                <DatePicker fx:id="toDatePicker"
                                            promptText="To Date"/>
                                
                                <Button text="Apply" onAction="#onApplyFilters"
                                        styleClass="btn-primary"/>
                                <Button text="Reset" onAction="#onResetFilters"
                                        styleClass="btn-secondary"/>
                            </HBox>
                            
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <padding>
                                    <Insets top="12"/>
                                </padding>
                                <Button text="Generate Report" onAction="#onGenerateReport"
                                        styleClass="btn-secondary"/>
                                <MenuButton text="Bulk Actions" styleClass="button">
                                    <items>
                                        <MenuItem text="Mark as In Progress"
                                                  onAction="#onBulkInProgress"/>
                                        <MenuItem text="Assign to Department"
                                                  onAction="#onBulkAssign"/>
                                        <MenuItem text="Export Selected"
                                                  onAction="#onBulkExport"/>
                                    </items>
                                </MenuButton>
                            </HBox>
                        </VBox>

                        <!-- Complaints Table -->
                        <TableView fx:id="complaintsTable" prefHeight="500"
                                   styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="selectColumn" prefWidth="40">
                                    <graphic>
                                        <CheckBox fx:id="selectAllCheckbox"/>
                                    </graphic>
                                </TableColumn>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                                <TableColumn fx:id="studentColumn" text="Student" prefWidth="120"/>
                                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="100"/>
                                <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="90"/>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                                <TableColumn fx:id="assignedColumn" text="Assigned" prefWidth="120"/>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"/>
                            </columns>
                            
                            <placeholder>
                                <VBox alignment="CENTER" spacing="16" styleClass="empty-state">
                                    <Label text="No complaints found" styleClass="empty-state-title"/>
                                    <Label text="Try adjusting your filters"
                                           styleClass="empty-state-message"/>
                                </VBox>
                            </placeholder>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="prevPageBtn" text="Previous"
                                    onAction="#onPrevPage" styleClass="btn-secondary"/>
                            <Label fx:id="pageInfoLabel" text="Page 1 of 1"/>
                            <Button fx:id="nextPageBtn" text="Next"
                                    onAction="#onNextPage" styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
